import Mathlib

/-!
# `E-HAT-2.1-25`: the prepend-cone subdivision recursion and its coefficients

Hatcher defines the barycentric subdivision operator by `S λ = b_λ (S ∂λ)`, where the cone `b_λ`
prepends the barycentre of the whole simplex `λ`. This file models that recursion where it lives: on
the free abelian group generated by *ordered chains of faces* of the standard domain simplex
`[e_0, …, e_n]`, that is, on `FreeAbelianGroup (List (Finset (Fin N)))` with `N = n + 1`. A chain
`[F_n, F_{n-1}, …, F_0]` records the barycentric vertices `b_{F_n}, …, b_{F_0}` of a summand, from
the whole simplex down.

The mathematical content of the card is that the coefficient of the `π`-summand is
`(-1)^{n(n+1)/2} sgn(π)`. That decomposes into two statements, both proved here.

* **Deletion positions.** `stepSign`/`stepExp` (`stepSign_eq_pow_stepExp`) is the sign of the summand
  obtained by peeling the vertices of the simplex in some order: at each stage the factor is `-1` to
  the power of the *position of the peeled vertex in the face it is peeled from*, which is the sign
  that the boundary `∂λ` contributes at that stage. `stepExp_eq_pairCount` shows the accumulated
  exponent depends only on the order and not on the intermediate faces: it is the number of pairs
  `i < j` in the peeling order with `l_j < l_i`. That is the deletion-index identity.
* **The recursion really produces those chains.** `subdiv` is Hatcher's recursion in this group, and
  `coeff_subdiv` computes *every* coefficient of it; `coeff_subdiv_chainOf` specialises to the chain
  of a peeling order, where the coefficient is exactly `stepSign`. So the coefficient formula is
  attached to the recursion, not to a guess about it.

Not in this file: the geometric transport from these chains to singular chains of `Δ^n`, and hence the
identification of `subdiv` with the operator on `C_n(X)`.
-/

open scoped BigOperators

namespace BarySubdiv

variable {N : ℕ}

/-! ## 1. Deletion positions, the recursive sign, and their aggregation -/

/-- The position of `v` among the vertices of `F`, counted from `0` in ascending order. -/
def deletionPos (F : Finset (Fin N)) (v : Fin N) : ℕ := (F.filter (fun u => u < v)).card

/-- The exponent carried by the prepend-cone recursion along a peeling order: the sum of the deletion
positions of the peeled vertices in the faces they are peeled from. -/
def stepExp (F : Finset (Fin N)) : List (Fin N) → ℕ
  | [] => 0
  | v :: l => deletionPos F v + stepExp (F.erase v) l

/-- The sign carried by the prepend-cone recursion along a peeling order. -/
def stepSign (F : Finset (Fin N)) : List (Fin N) → ℤˣ
  | [] => 1
  | v :: l => (-1 : ℤˣ) ^ deletionPos F v * stepSign (F.erase v) l

/-- The recursion's sign is `-1` to the recursion's exponent. -/
theorem stepSign_eq_pow_stepExp (F : Finset (Fin N)) (l : List (Fin N)) :
    stepSign F l = (-1 : ℤˣ) ^ stepExp F l := by
  induction l generalizing F with
  | nil => simp [stepSign, stepExp]
  | cons v l ih => simp only [stepSign, stepExp, ih, ← pow_add]

/-- The same exponent, counted without reference to the intermediate faces: pairs `i < j` of the
peeling order with `l_j < l_i`. -/
def pairCount (N : ℕ) : List (Fin N) → ℕ
  | [] => 0
  | v :: l => (l.filter (fun u => u < v)).length + pairCount N l

/-- **The deletion-index identity.** Over a whole peeling of `F`, the accumulated deletion positions
are the number of "later, smaller" pairs of the peeling order. -/
theorem stepExp_eq_pairCount {F : Finset (Fin N)} {l : List (Fin N)} (hl : l.Nodup)
    (hF : l.toFinset = F) : stepExp F l = pairCount N l := by
  induction l generalizing F with
  | nil => simp [stepExp, pairCount]
  | cons v l ih =>
      obtain ⟨hv, hnd⟩ := List.nodup_cons.mp hl
      have hdel : deletionPos F v = (l.filter (fun u => u < v)).length := by
        rw [deletionPos, ← hF, List.toFinset_cons, Finset.filter_insert, if_neg (lt_irrefl v),
          List.filter_toFinset, List.toFinset_card_of_nodup (hnd.filter _)]
      have hFe : l.toFinset = F.erase v := by
        rw [← hF, List.toFinset_cons, Finset.erase_insert (by simpa using hv)]
      rw [stepExp, pairCount, ih hnd hFe, hdel]

/-! ## 2. The recursion on chains of faces -/

/-- The chain of faces produced by peeling the vertices in the order of the list, truncated at a
single vertex: `chainOf F [v, w] = [F, F \ {v}]` for a three-vertex `F`. -/
def chainOf (F : Finset (Fin N)) : List (Fin N) → List (Finset (Fin N))
  | [] => [F]
  | v :: l => if F.card ≤ 1 then [F] else F :: chainOf (F.erase v) l

theorem chainOf_nil (F : Finset (Fin N)) : chainOf F [] = [F] := rfl

theorem chainOf_cons {F : Finset (Fin N)} (v : Fin N) (l : List (Fin N)) (h : ¬ F.card ≤ 1) :
    chainOf F (v :: l) = F :: chainOf (F.erase v) l := by
  simp only [chainOf]
  rw [if_neg h]

theorem chainOf_ne_nil (F : Finset (Fin N)) (l : List (Fin N)) : chainOf F l ≠ [] := by
  match l with
  | [] => simp [chainOf]
  | v :: l =>
      simp only [chainOf]
      split <;> simp

theorem chainOf_head (F : Finset (Fin N)) (l : List (Fin N)) :
    (chainOf F l).head? = some F := by
  match l with
  | [] => simp [chainOf]
  | v :: l =>
      simp only [chainOf]
      split <;> simp

/-- Hatcher's recursion `S λ = b_λ (S ∂λ)` in the free abelian group on ordered chains of faces, with
an explicit fuel so that the recursion is structural. Each summand cones with the barycentre of the
current face, which in the chain picture is exactly the list prepend. -/
def subdivAux (N : ℕ) : ℕ → Finset (Fin N) → FreeAbelianGroup (List (Finset (Fin N)))
  | 0, F => FreeAbelianGroup.of [F]
  | k + 1, F =>
      if F.card ≤ 1 then FreeAbelianGroup.of [F]
      else ∑ v ∈ F.attach,
        (((-1 : ℤˣ) ^ deletionPos F v.1 : ℤˣ) : ℤ) •
          FreeAbelianGroup.map (List.cons F) (subdivAux N k (F.erase v.1))

/-- The subdivision operator `S` on the free abelian group on chains of faces of the standard
`N - 1`-simplex. -/
def subdiv (F : Finset (Fin N)) : FreeAbelianGroup (List (Finset (Fin N))) :=
  subdivAux N F.card F

theorem subdivAux_zero (F : Finset (Fin N)) : subdivAux N 0 F = FreeAbelianGroup.of [F] := rfl

theorem subdivAux_succ (k : ℕ) (F : Finset (Fin N)) :
    subdivAux N (k + 1) F =
      (if F.card ≤ 1 then FreeAbelianGroup.of [F]
        else ∑ v ∈ F.attach,
          (((-1 : ℤˣ) ^ deletionPos F v.1 : ℤˣ) : ℤ) •
            FreeAbelianGroup.map (List.cons F) (subdivAux N k (F.erase v.1))) := rfl

theorem subdivAux_succ_le (k : ℕ) {F : Finset (Fin N)} (h : F.card ≤ 1) :
    subdivAux N (k + 1) F = FreeAbelianGroup.of [F] := by
  rw [subdivAux_succ, if_pos h]

theorem subdivAux_succ_gt (k : ℕ) {F : Finset (Fin N)} (h : ¬ F.card ≤ 1) :
    subdivAux N (k + 1) F = ∑ v ∈ F.attach,
      (((-1 : ℤˣ) ^ deletionPos F v.1 : ℤˣ) : ℤ) •
        FreeAbelianGroup.map (List.cons F) (subdivAux N k (F.erase v.1)) := by
  rw [subdivAux_succ, if_neg h]

/-! ## 3. Coefficients: the recursion is the identity `stepSign` -/

/-- The coefficient of a free-abelian generator. -/
theorem coeff_of (a b : List (Finset (Fin N))) :
    FreeAbelianGroup.coeff a (FreeAbelianGroup.of b) = if b = a then 1 else 0 := by
  simp only [FreeAbelianGroup.coeff, AddMonoidHom.coe_comp, Function.comp_apply,
    FreeAbelianGroup.toFinsupp_of]
  exact Finsupp.single_apply

/-- Prepending the top face is injective on chains, so it transports coefficients. -/
theorem coeff_map_cons_cons (F : Finset (Fin N)) (X : FreeAbelianGroup (List (Finset (Fin N))))
    (c : List (Finset (Fin N))) :
    FreeAbelianGroup.coeff (F :: c) (FreeAbelianGroup.map (List.cons F) X) =
      FreeAbelianGroup.coeff c X := by
  have key : ∀ a : List (Finset (Fin N)),
      FreeAbelianGroup.coeff (F :: c)
        (FreeAbelianGroup.map (List.cons F) (FreeAbelianGroup.of a)) =
      FreeAbelianGroup.coeff c (FreeAbelianGroup.of a) := by
    intro a
    rw [FreeAbelianGroup.map_of_apply, coeff_of, coeff_of]
    simp
  induction X using FreeAbelianGroup.induction_on with
  | zero => simp
  | of a => exact key a
  | neg x ih => simp only [map_neg, ih]
  | add x y ihx ihy => simp only [map_add, ihx, ihy]

/-- A chain that does not start with the top face is not in the image of the prepend. -/
theorem coeff_map_cons_of_ne (F : Finset (Fin N)) (X : FreeAbelianGroup (List (Finset (Fin N))))
    {c : List (Finset (Fin N))} (h : ∀ c', c ≠ F :: c') :
    FreeAbelianGroup.coeff c (FreeAbelianGroup.map (List.cons F) X) = 0 := by
  have key : ∀ a : List (Finset (Fin N)),
      FreeAbelianGroup.coeff c
        (FreeAbelianGroup.map (List.cons F) (FreeAbelianGroup.of a)) = 0 := by
    intro a
    rw [FreeAbelianGroup.map_of_apply, coeff_of, if_neg (fun hh => h a hh.symm)]
  induction X using FreeAbelianGroup.induction_on with
  | zero => simp
  | of a => exact key a
  | neg x ih => simp only [map_neg, ih, neg_zero]
  | add x y ihx ihy => simp only [map_add, ihx, ihy, add_zero]

/-- The coefficient that the recursion predicts for a chain: `1` on the base chain `[F]` of a simplex
with at most one vertex, and otherwise the sum of the signs over the peelings whose next face matches.
-/
def chainCoeff (F : Finset (Fin N)) : List (Finset (Fin N)) → ℤ
  | [] => 0
  | [G] => if G = F ∧ F.card ≤ 1 then 1 else 0
  | G :: G' :: rest =>
      if G = F ∧ ¬ F.card ≤ 1 then ∑ v ∈ F.attach,
        (if G' = F.erase v.1 then
          (((-1 : ℤˣ) ^ deletionPos F v.1 : ℤˣ) : ℤ) * chainCoeff (F.erase v.1) (G' :: rest)
        else 0)
      else 0

theorem chainCoeff_nil (F : Finset (Fin N)) : chainCoeff F [] = 0 := by
  simp only [chainCoeff]

theorem chainCoeff_singleton (F G : Finset (Fin N)) :
    chainCoeff F [G] = if G = F ∧ F.card ≤ 1 then 1 else 0 := by
  simp only [chainCoeff]

theorem chainCoeff_cons_cons (F G G' : Finset (Fin N)) (rest : List (Finset (Fin N))) :
    chainCoeff F (G :: G' :: rest) = if G = F ∧ ¬ F.card ≤ 1 then ∑ v ∈ F.attach,
        (if G' = F.erase v.1 then
          (((-1 : ℤˣ) ^ deletionPos F v.1 : ℤˣ) : ℤ) * chainCoeff (F.erase v.1) (G' :: rest)
        else 0)
      else 0 := by
  simp only [chainCoeff]

/-- On a simplex with at most one vertex the recursion has a single summand. -/
theorem chainCoeff_of_card_le_one {F : Finset (Fin N)} (h : F.card ≤ 1)
    (c : List (Finset (Fin N))) : chainCoeff F c = if c = [F] then 1 else 0 := by
  match c with
  | [] => rw [chainCoeff_nil]; simp
  | [G] =>
      rw [chainCoeff_singleton]
      by_cases hG : G = F
      · rw [if_pos ⟨hG, h⟩, if_pos (by rw [hG])]
      · rw [if_neg (fun hh => hG hh.1),
          if_neg (fun hh => hG (List.singleton_inj.mp hh))]
  | G :: G' :: rest =>
      rw [chainCoeff_cons_cons, if_neg (fun hh => hh.2 h)]
      rw [if_neg (by simp)]

/-- A chain with a nonzero predicted coefficient starts at its own face. -/
theorem chainCoeff_head {F : Finset (Fin N)} {c : List (Finset (Fin N))}
    (h : chainCoeff F c ≠ 0) : c.head? = some F := by
  match c with
  | [] => rw [chainCoeff_nil] at h; exact absurd rfl h
  | [G] =>
      rw [chainCoeff_singleton] at h
      by_cases hc : G = F ∧ F.card ≤ 1
      · rw [if_pos hc] at h
        rw [hc.1]
        rfl
      · rw [if_neg hc] at h
        exact absurd rfl h
  | G :: G' :: rest =>
      rw [chainCoeff_cons_cons] at h
      by_cases hc : G = F ∧ ¬ F.card ≤ 1
      · rw [if_pos hc] at h
        rw [hc.1]
        rfl
      · rw [if_neg hc] at h
        exact absurd rfl h

/-- Conversely, a chain whose head is not the deleted face has predicted coefficient zero. -/
theorem chainCoeff_cons_eq_zero {F : Finset (Fin N)} {v : Fin N} {G' : Finset (Fin N)}
    {rest : List (Finset (Fin N))} (h : G' ≠ F.erase v) :
    chainCoeff (F.erase v) (G' :: rest) = 0 := by
  by_contra hc
  have hhead := chainCoeff_head hc
  rw [List.head?_cons] at hhead
  exact h (Option.some.inj hhead)

/-- Erasing two different vertices of a finset gives different finsets. -/
theorem erase_inj_of_eq {F : Finset (Fin N)} {u v : Fin N} (hu : u ∈ F)
    (h : F.erase u = F.erase v) : u = v := by
  by_contra hne
  have hu' : u ∈ F.erase v := Finset.mem_erase.mpr ⟨hne, hu⟩
  rw [← h] at hu'
  exact (Finset.mem_erase.mp hu').1 rfl

/-- **Every coefficient of the recursion.** -/
theorem coeff_subdivAux (n : ℕ) (F : Finset (Fin N)) :
    ∀ c : List (Finset (Fin N)), F.card ≤ n →
      FreeAbelianGroup.coeff c (subdivAux N n F) = chainCoeff F c := by
  induction n generalizing F with
  | zero =>
      intro c h
      have hF : F = ∅ := Finset.card_eq_zero.mp (Nat.le_zero.mp h)
      subst hF
      rw [subdivAux_zero, chainCoeff_of_card_le_one (by simp : (∅ : Finset (Fin N)).card ≤ 1),
        coeff_of]
      by_cases hc : c = [∅]
      · rw [if_pos hc, if_pos (by rw [hc])]
      · rw [if_neg hc, if_neg (fun hh => hc hh.symm)]
  | succ n ih =>
      intro c h
      by_cases h1 : F.card ≤ 1
      · rw [subdivAux_succ_le n h1, chainCoeff_of_card_le_one h1, coeff_of]
        by_cases hc : c = [F]
        · rw [if_pos hc, if_pos (by rw [hc])]
        · rw [if_neg hc, if_neg (fun hh => hc hh.symm)]
      · rw [subdivAux_succ_gt n h1, map_sum]
        cases c with
        | nil =>
            have hz : ∀ v ∈ F.attach,
                FreeAbelianGroup.coeff ([] : List (Finset (Fin N)))
                    ((((-1 : ℤˣ) ^ deletionPos F v.1 : ℤˣ) : ℤ) •
                      FreeAbelianGroup.map (List.cons F) (subdivAux N n (F.erase v.1))) = 0 := by
              intro v _
              rw [map_zsmul, Int.zsmul_eq_mul,
                coeff_map_cons_of_ne F _ (by intro c'; simp), mul_zero]
            rw [Finset.sum_eq_zero hz, chainCoeff_nil]
        | cons G rest =>
            cases rest with
            | nil =>
                by_cases hG : G = F
                · rw [hG] at *
                  have hstep : ∀ v ∈ F.attach,
                      FreeAbelianGroup.coeff (F :: ([] : List (Finset (Fin N))))
                          ((((-1 : ℤˣ) ^ deletionPos F v.1 : ℤˣ) : ℤ) •
                            FreeAbelianGroup.map (List.cons F) (subdivAux N n (F.erase v.1)))
                        = (((-1 : ℤˣ) ^ deletionPos F v.1 : ℤˣ) : ℤ) *
                            chainCoeff (F.erase v.1) [] := by
                    intro v _
                    rw [map_zsmul, Int.zsmul_eq_mul, coeff_map_cons_cons,
                      ih (F.erase v.1) [] (by
                        have := Finset.card_erase_lt_of_mem v.2; omega)]
                  rw [Finset.sum_congr rfl hstep]
                  have hz : ∀ v ∈ F.attach,
                      (((-1 : ℤˣ) ^ deletionPos F v.1 : ℤˣ) : ℤ) *
                        chainCoeff (F.erase v.1) ([] : List (Finset (Fin N))) = 0 := by
                    intro v _
                    rw [chainCoeff_nil, mul_zero]
                  rw [Finset.sum_eq_zero hz, chainCoeff_singleton,
                    if_neg (fun hh => h1 hh.2)]
                · have hz : ∀ v ∈ F.attach,
                      FreeAbelianGroup.coeff (G :: ([] : List (Finset (Fin N))))
                          ((((-1 : ℤˣ) ^ deletionPos F v.1 : ℤˣ) : ℤ) •
                            FreeAbelianGroup.map (List.cons F) (subdivAux N n (F.erase v.1))) = 0 := by
                    intro v _
                    rw [map_zsmul, Int.zsmul_eq_mul,
                      coeff_map_cons_of_ne F _ (by
                        intro c' hc
                        simp only [List.cons.injEq] at hc
                        exact hG hc.1), mul_zero]
                  rw [Finset.sum_eq_zero hz, chainCoeff_singleton,
                    if_neg (fun hh => hG hh.1)]
            | cons G' rest' =>
                by_cases hG : G = F
                · rw [hG] at *
                  have hstep : ∀ v ∈ F.attach,
                      FreeAbelianGroup.coeff (F :: G' :: rest')
                          ((((-1 : ℤˣ) ^ deletionPos F v.1 : ℤˣ) : ℤ) •
                            FreeAbelianGroup.map (List.cons F) (subdivAux N n (F.erase v.1)))
                        = (((-1 : ℤˣ) ^ deletionPos F v.1 : ℤˣ) : ℤ) *
                            chainCoeff (F.erase v.1) (G' :: rest') := by
                    intro v _
                    rw [map_zsmul, Int.zsmul_eq_mul, coeff_map_cons_cons,
                      ih (F.erase v.1) (G' :: rest') (by
                        have := Finset.card_erase_lt_of_mem v.2; omega)]
                  rw [Finset.sum_congr rfl hstep, chainCoeff_cons_cons, if_pos ⟨rfl, h1⟩]
                  refine Finset.sum_congr rfl fun v _ => ?_
                  by_cases hv : G' = F.erase v.1
                  · rw [if_pos hv]
                  · rw [if_neg hv, chainCoeff_cons_eq_zero hv, mul_zero]
                · have hz : ∀ v ∈ F.attach,
                      FreeAbelianGroup.coeff (G :: G' :: rest')
                          ((((-1 : ℤˣ) ^ deletionPos F v.1 : ℤˣ) : ℤ) •
                            FreeAbelianGroup.map (List.cons F) (subdivAux N n (F.erase v.1))) = 0 := by
                    intro v _
                    rw [map_zsmul, Int.zsmul_eq_mul,
                      coeff_map_cons_of_ne F _ (by
                        intro c' hc
                        simp only [List.cons.injEq] at hc
                        exact hG hc.1), mul_zero]
                  rw [Finset.sum_eq_zero hz, chainCoeff_cons_cons,
                    if_neg (fun hh => hG hh.1)]

theorem coeff_subdiv (F : Finset (Fin N)) (c : List (Finset (Fin N))) :
    FreeAbelianGroup.coeff c (subdiv F) = chainCoeff F c :=
  coeff_subdivAux F.card F c le_rfl

/-- **The coefficient of a peeling's chain.** For a peeling order of the vertices of `F`, the
recursion's coefficient of the resulting chain is the recursive sign at that order. -/
theorem coeff_subdiv_chainOf {F : Finset (Fin N)} {l : List (Fin N)} (hl : l.Nodup)
    (hF : l.toFinset = F) :
    FreeAbelianGroup.coeff (chainOf F l) (subdiv F) = ((stepSign F l : ℤˣ) : ℤ) := by
  rw [coeff_subdiv]
  induction l generalizing F with
  | nil =>
      have hF0 : F = ∅ := by rw [← hF]; simp
      subst hF0
      have hcard : (∅ : Finset (Fin N)).card ≤ 1 := by simp
      rw [chainOf_nil, chainCoeff_of_card_le_one hcard, if_pos rfl]
      simp [stepSign]
  | cons v l ih =>
      obtain ⟨hv, hnd⟩ := List.nodup_cons.mp hl
      have hvF : v ∈ F := by rw [← hF]; simp
      have hFe : l.toFinset = F.erase v := by
        rw [← hF, List.toFinset_cons, Finset.erase_insert (by simpa using hv)]
      have hFins : F = insert v l.toFinset := by rw [← hF, List.toFinset_cons]
      by_cases h1 : F.card ≤ 1
      · have hv' : v ∉ l.toFinset := by simpa using hv
        have hcard : (l.toFinset).card + 1 = F.card := by
          rw [hFins, Finset.card_insert_of_notMem hv']
        have hlempty : l.toFinset = ∅ := by
          rw [← Finset.card_eq_zero]
          omega
        have hl0 : l = [] :=
          List.eq_nil_iff_forall_not_mem.mpr (by
            intro x hx
            have hx2 : x ∈ l.toFinset := by simpa using hx
            rw [hlempty] at hx2
            exact Finset.notMem_empty x hx2)
        subst hl0
        have hFv : F = {v} := by rw [hFins]; simp
        subst hFv
        have hcard1 : ({v} : Finset (Fin N)).card ≤ 1 := by simp
        have hch : chainOf ({v} : Finset (Fin N)) [v] = [{v}] := by
          simp only [chainOf]
          rw [if_pos hcard1]
        have hdel : deletionPos ({v} : Finset (Fin N)) v = 0 := by
          rw [deletionPos, Finset.filter_singleton]
          simp
        have hsign : stepSign ({v} : Finset (Fin N)) [v] = 1 := by
          rw [show stepSign ({v} : Finset (Fin N)) [v]
              = (-1 : ℤˣ) ^ deletionPos ({v} : Finset (Fin N)) v *
                  stepSign (({v} : Finset (Fin N)).erase v) [] from rfl, hdel]
          rw [show stepSign (({v} : Finset (Fin N)).erase v) ([] : List (Fin N)) = 1 from rfl]
          simp
        rw [hch, chainCoeff_of_card_le_one hcard1, if_pos rfl, hsign]
        simp
      · have hv2 : 1 < F.card := by omega
        rw [chainOf_cons v l (by omega)]
        cases hC : chainOf (F.erase v) l with
        | nil => exact absurd hC (chainOf_ne_nil (F.erase v) l)
        | cons G' rest =>
            have hG' : G' = F.erase v := by
              have hhead := chainOf_head (F.erase v) l
              rw [hC, List.head?_cons] at hhead
              exact (Option.some.inj hhead)
            rw [hG'] at hC ⊢
            rw [chainCoeff_cons_cons, if_pos ⟨rfl, h1⟩]
            simp only [stepSign]
            have hcollapse : (∑ u ∈ F.attach,
                (if F.erase v = F.erase u.1 then
                  (((-1 : ℤˣ) ^ deletionPos F u.1 : ℤˣ) : ℤ) *
                    chainCoeff (F.erase u.1) (F.erase v :: rest)
                else 0))
                = (if F.erase v = F.erase (↑(⟨v, hvF⟩ : {x // x ∈ F})) then
                    (((-1 : ℤˣ) ^ deletionPos F (↑(⟨v, hvF⟩ : {x // x ∈ F})) : ℤˣ) : ℤ) *
                      chainCoeff (F.erase (↑(⟨v, hvF⟩ : {x // x ∈ F}))) (F.erase v :: rest)
                  else 0) := by
              exact Finset.sum_eq_single (s := F.attach)
                (f := fun u : {x // x ∈ F} =>
                  (if F.erase v = F.erase u.1 then
                    (((-1 : ℤˣ) ^ deletionPos F u.1 : ℤˣ) : ℤ) *
                      chainCoeff (F.erase u.1) (F.erase v :: rest)
                  else 0)) ⟨v, hvF⟩
                (fun u _ hne => by
                  rw [if_neg (by
                    intro hu
                    exact hne (Subtype.ext (erase_inj_of_eq (u := v) (v := u.1) hvF hu).symm))])
                (fun hnot => absurd (Finset.mem_attach F ⟨v, hvF⟩) hnot)
            rw [hcollapse, if_pos rfl, ← hC, ih hnd hFe, Units.val_mul]

/-! ## 4. The aggregation, in the final form used by the card -/

/-- `-1` to a power, read in `ℤ` rather than in `ℤˣ`. -/
theorem val_neg_one_pow (k : ℕ) : (((-1 : ℤˣ) ^ k : ℤˣ) : ℤ) = (-1 : ℤ) ^ k := by
  induction k with
  | zero => simp
  | succ k ih =>
      rw [pow_succ, pow_succ, Units.val_mul, ih]
      simp

/-- The coefficient of a peeling's chain, as a power of `-1`: the deletion-index identity applied to
the recursion. -/
theorem coeff_subdiv_chainOf_eq_pow {F : Finset (Fin N)} {l : List (Fin N)} (hl : l.Nodup)
    (hF : l.toFinset = F) :
    FreeAbelianGroup.coeff (chainOf F l) (subdiv F) = (-1 : ℤ) ^ pairCount N l := by
  rw [coeff_subdiv_chainOf hl hF, stepSign_eq_pow_stepExp, stepExp_eq_pairCount hl hF,
    val_neg_one_pow]

/-! ## 5. The descending chain of a permutation, and the outermost deletion -/

/-- The position of a vertex in the whole simplex is its value: at the outermost step of the
recursion the face is the whole simplex. -/
theorem deletionPos_univ {N : ℕ} (v : Fin N) : deletionPos (Finset.univ) v = v.val := by
  have h : (Finset.univ.filter (fun u : Fin N => u < v)) = Finset.Iio v := by
    ext u
    simp
  rw [deletionPos, h, Fin.card_Iio]

/-- The peeling order of the vertices of the standard `N - 1`-simplex for a permutation `π`: the
recursion deletes from the top face down, so the deleted vertices are `π (N-1), π (N-2), …, π 0`. -/
def peel {N : ℕ} (π : Equiv.Perm (Fin N)) : List (Fin N) := List.ofFn fun i => π (Fin.rev i)

theorem peel_nodup {N : ℕ} (π : Equiv.Perm (Fin N)) : (peel π).Nodup :=
  List.nodup_ofFn.mpr (π.injective.comp Fin.rev_injective)

theorem peel_toFinset {N : ℕ} (π : Equiv.Perm (Fin N)) : (peel π).toFinset = Finset.univ := by
  refine Finset.eq_univ_of_forall fun a => ?_
  rw [List.mem_toFinset, peel, List.mem_ofFn', Set.mem_range]
  exact ⟨Fin.rev (π.symm a), by simp⟩

/-- **The coefficient of the descending chain of `π` in the recursion.** The chain is the one the
recursion builds by peeling `π (N-1), π (N-2), …, π 0`; its coefficient is `-1` to the number of
"later, smaller" pairs of that peeling order, which is the recursion's own sign. -/
theorem coeff_subdiv_peel {N : ℕ} (π : Equiv.Perm (Fin N)) :
    FreeAbelianGroup.coeff (chainOf Finset.univ (peel π)) (subdiv Finset.univ)
      = (-1 : ℤ) ^ pairCount N (peel π) :=
  coeff_subdiv_chainOf_eq_pow (peel_nodup π) (peel_toFinset π)

/-- The same coefficient, as the recursion's sign at the peeling order. -/
theorem coeff_subdiv_peel_stepSign {N : ℕ} (π : Equiv.Perm (Fin N)) :
    FreeAbelianGroup.coeff (chainOf Finset.univ (peel π)) (subdiv Finset.univ)
      = ((stepSign Finset.univ (peel π) : ℤˣ) : ℤ) :=
  coeff_subdiv_chainOf (peel_nodup π) (peel_toFinset π)

/-! ## 6. The geometric side: barycentric vertices and affine simplexes

The transport target is Hatcher's operator on singular chains of `Δ^n`. What is built here is the
geometric object a chain denotes: the barycentre of a face as a weight vector on the vertices, and the
affine map spanned by an ordered list of such vectors. That the chain of a peeling order denotes the
affine simplex on its barycentres in the descending order, and that the recursion's prepend is the
geometric cone, is *not* proved here; see `proofs/README.md`.
-/

/-- The barycentre of a face of the standard simplex, as a weight vector on the vertices. -/
noncomputable def baryWeight {N : ℕ} (F : Finset (Fin N)) : Fin N → ℝ :=
  fun i => if i ∈ F then ((F.card : ℝ))⁻¹ else 0

theorem baryWeight_mem {N : ℕ} {F : Finset (Fin N)} (hF : F.Nonempty) :
    baryWeight F ∈ stdSimplex ℝ (Fin N) := by
  have hcard : (F.card : ℝ) ≠ 0 := by
    have hpos : 0 < F.card := Finset.card_pos.mpr hF
    have : (0 : ℝ) < (F.card : ℝ) := by exact_mod_cast hpos
    exact ne_of_gt this
  have hbw : baryWeight F = fun i => if i ∈ F then ((F.card : ℝ))⁻¹ else 0 := rfl
  constructor
  · intro i
    show (0 : ℝ) ≤ if i ∈ F then ((F.card : ℝ))⁻¹ else 0
    by_cases hi : i ∈ F
    · rw [if_pos hi]
      positivity
    · rw [if_neg hi]
  · have h1 : (Finset.univ.filter (fun i : Fin N => i ∈ F)) = F := by
      ext i
      simp
    rw [hbw, ← Finset.sum_filter, h1, Finset.sum_const, nsmul_eq_mul]
    exact mul_inv_cancel₀ hcard

/-- The affine map spanned by an ordered list of vertex weight vectors: the point of the standard
simplex whose weights are those of `x`, spread over the listed vertices. -/
def affineMap {N : ℕ} (m : ℕ) (v : Fin (m+1) → Fin N → ℝ) : (Fin (m+1) → ℝ) → Fin N → ℝ :=
  fun x i => ∑ k, x k * v k i

theorem affineMap_mem {N m : ℕ} {v : Fin (m+1) → Fin N → ℝ}
    (hv : ∀ k, v k ∈ stdSimplex ℝ (Fin N)) {x : Fin (m+1) → ℝ}
    (hx : x ∈ stdSimplex ℝ (Fin (m+1))) : affineMap m v x ∈ stdSimplex ℝ (Fin N) := by
  constructor
  · intro i
    exact Finset.sum_nonneg fun k _ => mul_nonneg (hx.1 k) ((hv k).1 i)
  · have h2 : ∀ k : Fin (m+1), ∑ i : Fin N, x k * v k i = x k := by
      intro k
      rw [← Finset.mul_sum, (hv k).2, mul_one]
    calc ∑ i : Fin N, ∑ k : Fin (m+1), x k * v k i
        = ∑ k : Fin (m+1), ∑ i : Fin N, x k * v k i := Finset.sum_comm
      _ = ∑ k : Fin (m+1), x k := Finset.sum_congr rfl fun k _ => h2 k
      _ = 1 := hx.2

/-- The `k`-th vertex of the standard `m`-simplex, as a weight vector. -/
def vertexWeight {m : ℕ} (k : Fin (m+1)) : Fin (m+1) → ℝ := fun i => if i = k then 1 else 0

theorem vertexWeight_self {m : ℕ} (k : Fin (m+1)) : vertexWeight k k = 1 := if_pos rfl

theorem vertexWeight_of_ne {m : ℕ} {j k : Fin (m+1)} (h : j ≠ k) : vertexWeight k j = 0 :=
  if_neg h

/-- The vertices are points of the standard simplex. -/
theorem vertexWeight_mem {m : ℕ} (k : Fin (m+1)) :
    vertexWeight k ∈ stdSimplex ℝ (Fin (m+1)) := by
  constructor
  · intro i
    by_cases hi : i = k
    · rw [vertexWeight, if_pos hi]
      norm_num
    · rw [vertexWeight, if_neg hi]
  · rw [Finset.sum_eq_single k]
    · exact vertexWeight_self k
    · intro j _ hj
      exact vertexWeight_of_ne hj
    · intro hnot
      exact absurd (Finset.mem_univ k) hnot

/-- The affine map takes the `k`-th vertex of the standard simplex to the `k`-th listed vertex: the
listed vectors really are its vertices. -/
theorem affineMap_single {N m : ℕ} {v : Fin (m+1) → Fin N → ℝ} (k : Fin (m+1)) :
    affineMap m v (vertexWeight k) = v k := by
  funext i
  rw [affineMap, Finset.sum_eq_single k]
  · rw [vertexWeight_self, one_mul]
  · intro j _ hj
    rw [vertexWeight_of_ne hj, zero_mul]
  · intro hnot
    exact absurd (Finset.mem_univ k) hnot

/-- The face of the standard simplex spanned by the first `k+1` vertices of the permutation, counted
from the top: `b_{π 0, …, π (N-1-k)}`. -/
def descFace {N : ℕ} (π : Equiv.Perm (Fin N)) (k : Fin N) : Finset (Fin N) :=
  (Finset.Iic (Fin.rev k)).image π

theorem descFace_nonempty {N : ℕ} (π : Equiv.Perm (Fin N)) (k : Fin N) :
    (descFace π k).Nonempty :=
  ⟨π (Fin.rev k), Finset.mem_image_of_mem π (Finset.mem_Iic.mpr le_rfl)⟩

/-- The descending barycentric vertex list of the chain of `π`: vertex `k` is the barycentre of the
face of the `N-k` lowest vertices `π 0, …, π (N-1-k)`. -/
noncomputable def descVertex {N : ℕ} (π : Equiv.Perm (Fin N)) (k : Fin N) : Fin N → ℝ :=
  baryWeight (descFace π k)

theorem descVertex_mem {N : ℕ} (π : Equiv.Perm (Fin N)) (k : Fin N) :
    descVertex π k ∈ stdSimplex ℝ (Fin N) :=
  baryWeight_mem (descFace_nonempty π k)

/-- **The cone prepends the barycentre of the whole simplex**: the first vertex of the descending
chain is `b_{Δ^{N-1}}`, the barycentre of the whole standard simplex, and the last is a barycentre of
a single vertex. This is the ordering the recursion's `b_λ` produces. -/
theorem descVertex_zero {M : ℕ} (π : Equiv.Perm (Fin (M+1))) :
    descVertex π 0 = baryWeight (Finset.univ : Finset (Fin (M+1))) := by
  have hrev : Fin.rev (0 : Fin (M+1)) = Fin.last M := Fin.ext (by simp [Fin.rev, Fin.last])
  have h : descFace π 0 = Finset.univ := by
    ext i
    rw [descFace, hrev]
    simp only [Finset.mem_image, Finset.mem_Iic, Finset.mem_univ, iff_true]
    refine ⟨π.symm i, ?_, by simp⟩
    show ((π.symm i).val ≤ M)
    have := (π.symm i).isLt
    omega
  rw [descVertex, h]

end BarySubdiv

