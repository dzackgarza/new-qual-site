+    # none of what it carries: its TeX Live, its pdf2svg, its uv, its just (#122).
+    for name in ("build", "reports"):
+        assert jobs[name]["container"] == {"image": "ghcr.io/dzackgarza/sage:develop"}
+    provisioning = [*jobs["build"]["steps"], *jobs["reports"]["steps"]]
+    assert not [
+        step
