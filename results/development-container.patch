+# Provision the hosted test suite inside the research image (#122). The image
+# carries the TeX Live, pdf2svg, uv and just that `_ci-setup` installs on a bare
+# runner, so the one thing a container run does not have is the author's
+# pandoc-config, which the emitter reads its tikzcd filter from and the macro
+# mirror reads its preamble from.
+[private]
+_ci-setup-image:
+    #!/usr/bin/env bash
+    set -euo pipefail
+    git clone --depth 1 https://github.com/dzackgarza/pandoc-config.git "$HOME/.pandoc"
+
 # Run the scheduled whole-tree audit (semgrep and debt scans) through the central implementation.
 ambient:
     @just -f ~/ai-review-ci/justfiles/python.just -d . ambient
