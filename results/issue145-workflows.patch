diff --git a/.github/workflows/ambient.yml b/.github/workflows/ambient.yml
index f15a1d7e48..657862554e 100644
--- a/.github/workflows/ambient.yml
+++ b/.github/workflows/ambient.yml
@@ -17,3 +17,28 @@ jobs:
       tier: ambient
       profile: 'python'
       infra_ref: 'main'
+  run-records:
+    # The audit itself runs inside the shared QC workflow, which a caller
+    # cannot add a step to; a run's records ride out in `.qc-triage/`, which
+    # that workflow uploads with `always()`. Republish them with the retention
+    # this repository states (issue #145). The ambient tier runs no test and no
+    # `qualc check` today, so this artifact is empty until it does.
+    needs: ambient
+    if: always()
+    runs-on: ubuntu-latest
+    steps:
+      - name: Collect the QC tier's artifact
+        uses: actions/download-artifact@634f93cb2916e3fdff6788551b99b062d0335ce0
+        continue-on-error: true
+        with:
+          pattern: qc-triage-${{ github.run_id }}-*
+          path: qc-triage
+          merge-multiple: true
+      - name: Upload this run's duration records
+        if: always()
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
+        with:
+          name: run-records-audit-${{ github.run_id }}-${{ github.run_attempt }}
+          path: qc-triage/run-records
+          if-no-files-found: warn
+          retention-days: 90
